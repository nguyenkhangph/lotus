# Lotus — Avalanche Fuji testnet only. Never commit a real .env.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
NETWORK=avalanche-fuji
ASSET_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Where evidence payments go (your service wallet).
TREASURY_ADDRESS=

# Deployer pays gas for contract deployment (test AVAX).
DEPLOYER_PRIVATE_KEY=
# Facilitator pays gas to settle "exact" (EIP-3009) payments and to anchor receipt hashes.
FACILITATOR_PRIVATE_KEY=

# Filled after `npm run deploy:fuji`
JAR_FACTORY_ADDRESS=
RECEIPTS_ADDRESS=
JAR_ADDRESS=

# Roles on the jar (addresses at deploy time, keys only where they are used)
APPROVER_ADDRESS=      # approval key (Telegram bot after the user taps "Duyệt")
GUARDIAN_ADDRESS=      # may cancel / lock only
AGENT_PRIVATE_KEY=     # relays signed spends, pays gas, cannot move funds alone
APPROVER_PRIVATE_KEY=  # demo only; in production this lives with the bot, never with the LLM

# Pricing (test USDC base units, 6 decimals): upto = base + perSource × sources, max maxSources
PRICE_BASE=50000
PRICE_PER_SOURCE=50000
PRICE_MAX_SOURCES=8
QUOTE_TTL_SECONDS=300
PORT=8402
LOTUS_API=http://localhost:8402
