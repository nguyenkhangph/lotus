{
  "name": "lotus",
  "version": "0.1.0",
  "description": "Lotus — paid x402 evidence scores for market claims on Avalanche Fuji. Grades evidence, never gives investment advice.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "npm run test:contracts && npm run test:api",
    "test:contracts": "hardhat test",
    "test:api": "mocha -r ts-node/register/transpile-only \"test-api/**/*.test.ts\"",
    "redteam": "ts-node --transpile-only redteam/run.ts",
    "typecheck": "tsc --noEmit -p .",
    "dev": "ts-node --transpile-only src/index.ts",
    "deploy:fuji": "hardhat run scripts/deploy.ts --network fuji",
    "demo:agent": "ts-node --transpile-only scripts/agent-demo.ts",
    "verify:fuji": "hardhat run scripts/verify.ts --network fuji",
    "jar": "ts-node --transpile-only scripts/jar.ts",
    "hnx": "ts-node --transpile-only scripts/hnx.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.4",
    "@openzeppelin/contracts": "^5.1.0",
    "@types/chai": "^5.2.3",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "chai": "^4.5.0",
    "dotenv": "^18.0.10",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.17",
    "mocha": "^10.8.2",
    "solc": "^0.8.24",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "5.6"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "private": true
}